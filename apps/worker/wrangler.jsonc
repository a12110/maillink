// 路径均相对本文件（apps/worker/）。字段含义见 docs/design/01-architecture-and-data.md §2。
// database_id 为本地占位值：本地模式（wrangler dev / d1 --local）不会连接 Cloudflare。
// 部署前需要替换为真实 id；MAIL_DB 必须填 cloudflare_temp_email 所用 D1 的 id。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mail-link",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "mail-link",
      "database_id": "00000000-0000-0000-0000-00000000a001",
      "migrations_dir": "migrations"
    },
    {
      // temp_email 的库，只读使用，本项目永不迁移它。
      // migrations_dir 指向一个必须保持为空的目录：不配置时 wrangler 默认用 ./migrations（即 APP_DB 的迁移），
      // 误敲 `wrangler d1 migrations apply MAIL_DB` 会把本项目的建表语句执行到 temp_email 的库。见该目录的 README。
      "binding": "MAIL_DB",
      "database_name": "temp-email-db",
      "database_id": "00000000-0000-0000-0000-00000000a002",
      "migrations_dir": "mail-db-no-migrations"
    }
  ],
  // Workers Rate Limiting：limit 与 period 是每个 binding 一组（period 只能是 10 或 60），
  // 须与 src/constants.ts 的 RATE_LIMITER_SETTINGS 一致。
  // namespace_id 是账号内唯一的正整数字符串，部署前按需调整。
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // 取件链接：每个标签页约 6 次/分钟轮询，加开始取码与取码，同一 NAT 下多个标签页共用一个桶，取 120
      "name": "LINK_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *", "17 3 * * *"]
  },
  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:8787"
  }
}
